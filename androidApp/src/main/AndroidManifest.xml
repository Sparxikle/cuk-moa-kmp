<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic (set per build type in build.gradle.kts): debug builds allow plain HTTP for the dev server
         (localhost via adb reverse); release builds allow it only when the API address itself is http:// -->
    <application
        android:label="가대모아"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:theme="@style/Theme.App"
        android:localeConfig="@xml/locales_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <!-- Rotating, folding or resizing (tablet, LG Wing swivel, keyboard case) keeps the activity: Compose relayouts,
                 so the open web page and scroll positions survive -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets (Glance). launchMode singleTask above: a widget tap reuses the open app (onNewIntent). -->
        <receiver
            android:name=".widget.CalendarWidgetReceiver"
            android:label="@string/widget_calendar_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_calendar" />
        </receiver>

        <receiver
            android:name=".widget.TimetableWidgetReceiver"
            android:label="@string/widget_timetable_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_timetable" />
        </receiver>

        <receiver
            android:name=".widget.AnnouncementsWidgetReceiver"
            android:label="@string/widget_announcements_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_announcements" />
        </receiver>

        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:label="@string/widget_today_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today" />
        </receiver>

        <receiver
            android:name=".widget.WeekWidgetReceiver"
            android:label="@string/widget_week_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_week" />
        </receiver>

        <activity
            android:name=".widget.WidgetSettingsActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
